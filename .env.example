# Desarrollo local de NotaryVerify. No incluir secretos, datos personales ni biometría.
NOTARYVERIFY_BACKEND_PORT=8000
NOTARYVERIFY_FRONTEND_PORT=5500

# Persistencia (#21). Vacías = valores por defecto: backend/data (/app/data en
# Docker) y sqlite:///<DATA_DIR>/notaryverify.db. Solo se admite SQLite.
# Con columnas faltantes el arranque se detiene; reinicio: python -m app.core.reset_db
NOTARYVERIFY_DATA_DIR=
NOTARYVERIFY_DATABASE_URL=

# Seguridad (#22). Vacías = valores por defecto. Orígenes CORS exactos separados
# por comas (por defecto http://127.0.0.1:5500,http://localhost:5500); "*" no se
# admite. Límite de cada carga en bytes (por defecto 5242880).
NOTARYVERIFY_CORS_ORIGINS=
NOTARYVERIFY_MAX_UPLOAD_BYTES=

# Usuarios locales opcionales para demostración. Establezca cada pareja completa
# fuera del repositorio; no hay credenciales predeterminadas.
# NOTARYVERIFY_BOOTSTRAP_OPERATOR_EMAIL=operador@example.test
# NOTARYVERIFY_BOOTSTRAP_OPERATOR_PASSWORD=use-una-clave-larga-no-versionada
# NOTARYVERIFY_BOOTSTRAP_ADMIN_EMAIL=administrador@example.test
# NOTARYVERIFY_BOOTSTRAP_ADMIN_PASSWORD=use-una-clave-larga-no-versionada
